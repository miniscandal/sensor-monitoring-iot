# MQTT Client Configuration

VITE_MQTT_BROKER_HOST=ws://localhost:8080
VITE_MQTT_BROKER_PORT=8080


# Mocks
VITE_USE_MQTT_CLIENT_MOCK=false
VITE_USE_ENVIRONMENTAL_NODE_MOCK=false


# Topics Subscribe

## Autenticación de nodos
VITE_TOPIC_NODE_AUTH_LOGIN=acme/ind/+/+/node/+/auth/login
VITE_TOPIC_NODE_AUTH_LOGOUT=acme/ind/+/+/node/+/auth/logout
VITE_TOPIC_NODE_AUTH_SESSION=acme/ind/+/+/node/+/auth/session

## Datos de sensores
VITE_TOPIC_NODE_DATA_SENSOR=acme/ind/+/+/node/+/data/sensor

## Información del nodo
VITE_TOPIC_NODE_METADATA=acme/ind/+/+/node/+/metadata

## Estado y resultados de operación
VITE_TOPIC_NODE_STATE_CODE=acme/ind/+/+/node/+/state-code
VITE_TOPIC_NODE_OPERATION_RESULT_CODE=acme/ind/+/+/node/+/operation-result-code


# Topics Publish

## Commands
VITE_TOPIC_ENVIRONMENTAL_NODE_COMMAND=acme/ind/{plant}/{line}/environmental-node/{id}/command
VITE_TOPIC_ENVIRONMENTAL_NODE_ALL_COMMAND=acme/ind/all_plant/all_line/environmental-node/all_id/command
