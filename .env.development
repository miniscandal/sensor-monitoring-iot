# MQTT Client Configuration

VITE_MQTT_BROKER_HOST=ws://localhost
VITE_MQTT_BROKER_PORT=8080


# Mocks
VITE_USE_MQTT_CLIENT_MOCK=false
VITE_USE_ENV_NODE_MOCK=false


# Topics Subscribe

# acme/ind/norte/l1/env-node/a001/state/birth
VITE_TOPIC_ENV_NODE_STATE_BIRTH=acme/ind/+/+/env-node/+/state/birth
# acme/ind/norte/l1/env-node/a001/state/death
VITE_TOPIC_ENV_NODE_STATE_DEATH=acme/ind/+/+/env-node/+/state/death

# acme/ind/norte/l1/env-node/a001/data/sensor/all
VITE_TOPIC_ENV_NODE_DATA_SENSOR_ALL=acme/ind/+/+/env-node/+/data/sensor/all

## Información del nodo
VITE_TOPIC_ENV_NODE_METADATA=acme/ind/+/+/node/+/metadata

## Estado y resultados de operación
VITE_TOPIC_ENV_NODE_STATE_CODE=acme/ind/+/+/node/+/state-code
VITE_TOPIC_ENV_NODE_OP_RESULT_CODE=acme/ind/+/+/node/+/ope-result-code


# Topics Publish

## Commands
VITE_TOPIC_ENV_NODE_COMMAND=acme/ind/{plant}/{line}/env-node/{id}/command
VITE_TOPIC_ALL_ENV_NODE_COMMAND=acme/ind/all/all/env-node/all/command
